# Supabase Database Configuration
# Public Client-Side Credentials (Safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Private Server-Side Service Role Key (Keep secret! Never prefix with NEXT_PUBLIC_)
# Find this in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Initial Admin Credentials (Change to a strong random password in production)
ADMIN_EMAIL=admin@bhai.com
ADMIN_PASSWORD=admin123

# Site URL Configuration (Used for production checkout links)
NEXT_PUBLIC_SITE_URL=https://bhai-woad.vercel.app

# Vapi Integration Authentication Secret
# Set this secret in your Vapi Custom Tool headers as:
# Authorization: Bearer your_vapi_secret_key_here OR x-vapi-secret: your_vapi_secret_key_here
VAPI_SECRET_KEY=your_vapi_secret_key_here

# Checkout Token Signing Secret (HMAC)
CHECKOUT_TOKEN_SECRET=your_checkout_token_signing_secret_here

# Abandoned Cart & Discount Business Rules
MAX_DISCOUNT_PERCENT=10
MIN_CART_VALUE_FOR_DISCOUNT=50
ABANDONED_CART_INACTIVE_MINUTES=30

# Optional Messaging Providers (Leave blank if not configuring yet)
# Option A: Meta WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Option B: Twilio (SMS or WhatsApp)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
# TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number

# Option C: Resend (Email fallback)
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=orders@bhaijeweller.co.uk
